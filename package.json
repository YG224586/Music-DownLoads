{
  "name": "music-downloads",
  "private": true,
  "version": "1.0.2",
  "license": "Apache-2.0",
  "description": "音乐下载 —— 安卓端音乐下载器（Tauri 2 + Vue 3 + Rust 下载核心）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "format:vue": "prettier --write \"src/**/*.vue\"",
    "format:vue:check": "prettier --check \"src/**/*.vue\"",
    "format:ts": "prettier --write \"src/**/*.ts\" vite.config.ts",
    "format:ts:check": "prettier --check \"src/**/*.ts\" vite.config.ts",
    "format:css": "prettier --write \"src/**/*.{css,scss,less}\"",
    "format:css:check": "prettier --check \"src/**/*.{css,scss,less}\"",
    "test:storage-recovery": "node --test scripts/storage-recovery.test.mjs",
    "generate:licenses": "node scripts/generate-licenses.mjs"
  },
  "dependencies": {
    "@sahil-vartak/tauri-plugin-safe-area-insets-css-api": "^0.2.1",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "core-js": "^3.50.0",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "naive-ui": "2.44.1",
    "pinia": "^4.0.3",
    "regenerator-runtime": "^0.14.1",
    "semver": "^7.8.5",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.13.3",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.9",
    "spdx-license-list": "^6.12.0",
    "terser": "^5.51.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
