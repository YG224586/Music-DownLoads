{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "音乐下载",
  "version": "1.0.5",
  "identifier": "com.musicdownloads.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "音乐下载",
        "width": 1600,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "安卓端音乐下载器",
    "longDescription": "音乐下载 —— 安卓端音乐下载器，基于 Tauri 2 与 Vue 3 构建界面，复用 Rust 下载核心，提供搜索、歌单导入、多任务下载、自动降级与音频解密等功能。",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../NOTICE": "licenses/NOTICE",
      "../THIRD_PARTY_LICENSES.txt": "licenses/THIRD_PARTY_LICENSES.txt"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
